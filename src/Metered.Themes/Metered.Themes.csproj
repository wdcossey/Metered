<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Metered.Themes</PackageId>
    <Description>Base Web's light and dark themes for Metered: every token under Base Web's own name, and the controls' templates.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- Merged by BaseTheme; see Directory.Build.targets. -->
  <PropertyGroup>
    <MeteredDiscoverXaml>true</MeteredDiscoverXaml>
  </PropertyGroup>
  <ItemGroup>
    <MeteredDiscoveredXaml Include="Tokens/**/*.axaml;Controls/**/*.axaml" />
  </ItemGroup>

  <!-- The token values are Base Web's (MIT): its notice travels with the package. -->
  <ItemGroup>
    <None Include="LICENSE-baseweb.txt" Pack="true" PackagePath="LICENSE-baseweb.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Metered.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metered.Controls\Metered.Controls.csproj" />
  </ItemGroup>

</Project>
