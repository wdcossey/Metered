  The themes of Tooltip's parts, Tooltip.Styled<Part>, from Base Web's tooltip: the Popover's style functions with the
  tooltip's own values over them, each part's look by the state pseudoclasses the Popover mirrors onto it
  (Metered.Controls.Tooltip), the colours, radii, shadows and font by token, the lengths read from Base Web's own style
  functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Body: the box placed against the anchor: its fill, radius, shadow and text colour; its opacity and fade by state, in place. -->
  <ControlTheme x:Key="Tooltip.StyledBody" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource colors.tooltipBackground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource borders.radius300}" />
    <Setter Property="BoxShadow" Value="{DynamicResource lighting.shadow400}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.tooltipText}" />
    <Setter Property="Opacity" Value="0" />
    <Style Selector="^:is-open:is-animating">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="00:00:00.100" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:is-hover-trigger:is-open">
      <Style.Animations>
        <Animation Duration="00:00:00.100" FillMode="None">
          <KeyFrame Cue="0%">
            <Setter Property="IsHitTestVisible" Value="False" />
          </KeyFrame>
          <KeyFrame Cue="99%">
            <Setter Property="IsHitTestVisible" Value="False" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="IsHitTestVisible" Value="True" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:is-open:is-animating">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>
  <!-- Arrow: the arrow, a box turned 45° behind Inner: its fill, shadow, size, and the side it sits beyond by placement. -->
  <ControlTheme x:Key="Tooltip.StyledArrow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource colors.tooltipBackground}" />
    <Setter Property="BoxShadow" Value="{DynamicResource lighting.shadow600}" />
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="RenderTransform" Value="rotate(45deg)" />
    <Setter Property="Canvas.Left" Value="NaN" />
    <Setter Property="Canvas.Top" Value="NaN" />
    <Setter Property="Canvas.Right" Value="NaN" />
    <Setter Property="Canvas.Bottom" Value="-4" />
    <Style Selector="^:placement-right-bottom">
      <Setter Property="Canvas.Left" Value="-4" />
    </Style>
    <Style Selector="^:placement-right">
      <Setter Property="Canvas.Left" Value="-4" />
    </Style>
    <Style Selector="^:placement-right-top">
      <Setter Property="Canvas.Left" Value="-4" />
    </Style>
    <Style Selector="^:placement-bottom-left">
      <Setter Property="Canvas.Top" Value="-4" />
    </Style>
    <Style Selector="^:placement-bottom">
      <Setter Property="Canvas.Top" Value="-4" />
    </Style>
    <Style Selector="^:placement-bottom-right">
      <Setter Property="Canvas.Top" Value="-4" />
    </Style>
    <Style Selector="^:placement-left-top">
      <Setter Property="Canvas.Right" Value="-4" />
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-left">
      <Setter Property="Canvas.Right" Value="-4" />
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-left-bottom">
      <Setter Property="Canvas.Right" Value="-4" />
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-bottom-left">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-bottom">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-bottom-right">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-right-bottom">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-right">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-right-top">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
  </ControlTheme>
  <!-- Inner: the content's box over the arrow: its fill, radius, padding, font and text colour; its text wrapped. -->
  <ControlTheme x:Key="Tooltip.StyledInner" TargetType="ContentPresenter">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="{DynamicResource colors.tooltipBackground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource borders.radius300}" />
    <Setter Property="Padding" Value="16,8,16,8" />
    <Setter Property="Foreground" Value="{DynamicResource colors.tooltipText}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.font150.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.font150.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.font150.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.font150.lineHeight}" />
  </ControlTheme>
</ResourceDictionary>
