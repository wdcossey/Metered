  The themes of FormControl's parts, FormControl.Styled<Part>, from Base Web's form control: each part's look by
  the state pseudoclasses the FormControl mirrors onto it (Metered.Controls.FormControl), the colours by token,
  the lengths read from Base Web's own style functions, the caption's icons from Base Web's own icons
  (icon/alert.js, icon/check.js).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- LabelContainer: the row of the label and its end enhancer, between its margins. -->
  <ControlTheme x:Key="FormControl.StyledLabelContainer" TargetType="b:FormControlLabelContainer">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,8,0,8" />
  </ControlTheme>
  <!-- Label: the label: its font, and its colour while disabled. -->
  <ControlTheme x:Key="FormControl.StyledLabel" TargetType="b:FormControlLabel">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextBlock.TextWrapping" Value="WrapWithOverflow" />
    <Setter Property="Padding" Value="0,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.font250.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.font250.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.font250.fontWeight}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font250.lineHeight}" />
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource colors.contentSecondary}" />
    </Style>
  </ControlTheme>
  <!-- LabelEndEnhancer: the label's end enhancer, the counter's text by default: its font, and its colour while disabled or past the counter's maximum. -->
  <ControlTheme x:Key="FormControl.StyledLabelEndEnhancer" TargetType="ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="TextWrapping" Value="WrapWithOverflow" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.font100.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.font100.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.font100.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.font100.lineHeight}" />
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:counter-error">
      <Setter Property="Foreground" Value="{DynamicResource colors.contentNegative}" />
    </Style>
  </ControlTheme>
  <!-- ControlContainer: the child and the caption, and the margin below them. -->
  <ControlTheme x:Key="FormControl.StyledControlContainer" TargetType="b:FormControlStack">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </ControlTheme>
  <!-- Caption: the caption, the error or the positive message: its font, margins, and colour by state. -->
  <ControlTheme x:Key="FormControl.StyledCaption" TargetType="Border">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,8,0,8" />
    <Setter Property="Padding" Value="0,0,0,0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentTertiary}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font100.fontFamily}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font100.fontSize}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font100.fontWeight}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font100.lineHeight}" />
    <Style Selector="^:positive">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentPositive}" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentNegative}" />
    </Style>
  </ControlTheme>
  <!-- CaptionIcon: Base Web's alert or check icon before an error or a positive message, in the caption's colour. -->
  <ControlTheme x:Key="FormControl.StyledCaptionIcon" TargetType="b:FormControlCaptionIcon">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Left" />
