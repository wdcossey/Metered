<!--
  Generated by tools/tokens/gen.js (tools/tokens/popover.js) from baseui 18.2.0
  (© Uber Technologies, Inc., MIT). Do not edit.
  The themes of Popover's parts, Popover.Styled<Part>, from Base Web's popover: each part's look by the state
  pseudoclasses the Popover mirrors onto it (Metered.Controls.Popover), the colours, radii and shadows by token,
  the lengths read from Base Web's own style functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Body: the box placed against the anchor: its fill, radius and shadow; its opacity and entrance by state. -->
  <ControlTheme x:Key="Popover.StyledBody" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource colors.backgroundTertiary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource borders.popoverBorderRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource lighting.shadow600}" />
    <Setter Property="Opacity" Value="0" />
    <Style Selector="^:is-open:is-animating">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="00:00:00.100" Easing="0.2,0.8,0.4,1" />
          <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.100" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:is-hover-trigger:is-open">
      <Style.Animations>
        <Animation Duration="00:00:00.100" FillMode="None">
          <KeyFrame Cue="0%">
            <Setter Property="IsHitTestVisible" Value="False" />
          </KeyFrame>
          <KeyFrame Cue="99%">
            <Setter Property="IsHitTestVisible" Value="False" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="IsHitTestVisible" Value="True" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:is-open:is-animating">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>
  <!-- Arrow: the arrow, a box turned 45° behind Inner: its fill, shadow, size, and the side it sits beyond by placement. -->
  <ControlTheme x:Key="Popover.StyledArrow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource colors.backgroundTertiary}" />
    <Setter Property="BoxShadow" Value="{DynamicResource lighting.shadow600}" />
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="RenderTransform" Value="rotate(45deg)" />
    <Setter Property="Canvas.Left" Value="NaN" />
    <Setter Property="Canvas.Top" Value="NaN" />
    <Setter Property="Canvas.Right" Value="NaN" />
    <Setter Property="Canvas.Bottom" Value="-4" />
    <Style Selector="^:placement-right-bottom">
      <Setter Property="Canvas.Left" Value="-4" />
    </Style>
    <Style Selector="^:placement-right">
      <Setter Property="Canvas.Left" Value="-4" />
    </Style>
    <Style Selector="^:placement-right-top">
      <Setter Property="Canvas.Left" Value="-4" />
    </Style>
    <Style Selector="^:placement-bottom-left">
      <Setter Property="Canvas.Top" Value="-4" />
    </Style>
    <Style Selector="^:placement-bottom">
      <Setter Property="Canvas.Top" Value="-4" />
    </Style>
    <Style Selector="^:placement-bottom-right">
      <Setter Property="Canvas.Top" Value="-4" />
    </Style>
    <Style Selector="^:placement-left-top">
      <Setter Property="Canvas.Right" Value="-4" />
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-left">
      <Setter Property="Canvas.Right" Value="-4" />
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-left-bottom">
      <Setter Property="Canvas.Right" Value="-4" />
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-bottom-left">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-bottom">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-bottom-right">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-right-bottom">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-right">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
    <Style Selector="^:placement-right-top">
      <Setter Property="Canvas.Bottom" Value="NaN" />
    </Style>
  </ControlTheme>
  <!-- Inner: the content's box over the arrow: its fill, radius and text colour. -->
  <ControlTheme x:Key="Popover.StyledInner" TargetType="ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource colors.backgroundTertiary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource borders.popoverBorderRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
  </ControlTheme>
  <!-- Padding: Base Web's StyledPadding, the padding it recommends round a popover's content. -->
  <ControlTheme x:Key="Popover.StyledPadding" TargetType="Border">
    <Setter Property="Padding" Value="12,12,12,12" />
  </ControlTheme>
</ResourceDictionary>
