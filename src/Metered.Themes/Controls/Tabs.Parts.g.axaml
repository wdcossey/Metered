<!--
  Generated by tools/tokens/gen.js (tools/tokens/tabs.js) from baseui 18.2.0
  (© Uber Technologies, Inc., MIT). Do not edit.
  The themes of Tabs' parts, Tabs.Styled<Part>, from Base Web's tabs-motion: each part's look by the state
  pseudoclasses the Tabs mirrors onto it (Metered.Controls.Tabs), the colours by token, the lengths and the motion
  read from Base Web's own style functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- The size tab.js gives a tab's artwork: an icon's width and height. -->
  <x:Double x:Key="Tabs.ArtworkSize">20</x:Double>
  <!-- Root: the tabs: a block of the bar, the border and the panels; a row, the panels taking the rest, when vertical. -->
  <ControlTheme x:Key="Tabs.StyledRoot" TargetType="b:TabsRootPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Style Selector="^:orientation-vertical">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
  </ControlTheme>
  <!-- TabBar: the tab list and the end enhancer, side by side. -->
  <ControlTheme x:Key="Tabs.StyledTabBar" TargetType="Grid" />
  <!-- TabList: the line of tabs: a scroller with no bar while intrinsic, its padding where the highlight is and a margin as much under it, so the border meets it. -->
  <ControlTheme x:Key="Tabs.StyledTabList" TargetType="b:TabList">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Padding" Value="0,0,0,5" />
    <Setter Property="Margin" Value="0,0,0,-5" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    <Style Selector="^:orientation-vertical">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="Padding" Value="0,0,5,0" />
      <Setter Property="Margin" Value="0,0,-5,0" />
      <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
    </Style>
    <Style Selector="^:fill-fixed">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="^:orientation-vertical">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
  </ControlTheme>
  <!-- Tab: a tab: its padding and type; the fill under a hovering mouse, the disabled colour (and no fill hovered), the inset focus ring; equal shares when fixed; its content at the end when vertical. -->
  <ControlTheme x:Key="Tabs.StyledTab" TargetType="b:TabButton">
    <Setter Property="TextBlock.TextWrapping" Value="WrapWithOverflow" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource colors.backgroundPrimary}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.LabelSmall.fontFamily}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.LabelSmall.fontSize}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.LabelSmall.fontWeight}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.LabelSmall.lineHeight}" />
    <Setter Property="OutlineBrush" Value="{x:Null}" />
    <Setter Property="OutlineThickness" Value="0" />
    <Setter Property="OutlineOffset" Value="-3" />
    <Setter Property="FlexGrow" Value="0" />
    <Setter Property="FlexBasis" Value="NaN" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="00:00:00.200" Easing="0,0,1,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="No" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:is-hovered">
      <Setter Property="Background" Value="{DynamicResource colors.backgroundSecondary}" />
    </Style>
    <Style Selector="^:disabled:is-hovered">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="OutlineBrush" Value="{DynamicResource colors.borderAccent}" />
      <Setter Property="OutlineThickness" Value="3" />
    </Style>
    <Style Selector="^:fill-fixed">
      <Setter Property="FlexGrow" Value="1" />
      <Setter Property="FlexBasis" Value="0" />
    </Style>
    <Style Selector="^:orientation-vertical">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
  </ControlTheme>
  <!-- ArtworkContainer: a tab's artwork, before its title. -->
  <ControlTheme x:Key="Tabs.StyledArtworkContainer" TargetType="ContentPresenter">
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentPrimary}" />
  </ControlTheme>
  <!-- TabHighlight: the bar under the active tab (beside it when vertical): its colour and thickness; its length and place the tab's, moving once a key has changed. -->
  <ControlTheme x:Key="Tabs.StyledTabHighlight" TargetType="b:TabHighlight">
    <Setter Property="Background" Value="{DynamicResource colors.borderSelected}" />
    <Setter Property="ZIndex" Value="1" />
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Length" Value="0" />
    <Setter Property="Distance" Value="0" />
    <Style Selector="^:animate">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Length" Duration="00:00:00.400" Easing="0.86,0,0.07,1" />
          <DoubleTransition Property="Distance" Duration="00:00:00.400" Easing="0.86,0,0.07,1" />
          <BrushTransition Property="Background" Duration="00:00:00.400" Easing="0.86,0,0.07,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:orientation-vertical">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
  </ControlTheme>
  <!-- TabBorder: the line under the tabs (beside them when vertical). -->
  <ControlTheme x:Key="Tabs.StyledTabBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource colors.borderOpaque}" />
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="5" />
    <Style Selector="^:orientation-vertical">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="NaN" />
    </Style>
  </ControlTheme>
  <!-- EndEnhancerContainer: the end enhancer, after the tab list, centred on its line. -->
  <ControlTheme x:Key="Tabs.StyledEndEnhancerContainer" TargetType="ContentPresenter">
    <Setter Property="Margin" Value="16,0,0,0" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </ControlTheme>
  <!-- TabPanel: a tab's panel, padded; only the active tab's is shown. -->
  <ControlTheme x:Key="Tabs.StyledTabPanel" TargetType="ContentPresenter">
    <Setter Property="TextWrapping" Value="WrapWithOverflow" />
    <Setter Property="Padding" Value="16" />
  </ControlTheme>
</ResourceDictionary>
