<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Root: the box: its 2 px border, radius and fill by state; the textarea's own width once it can be resized. -->
  <ControlTheme x:Key="Textarea.StyledRoot" TargetType="Border">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource colors.inputBorder}" />
    <Setter Property="Background" Value="{DynamicResource colors.inputFill}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0,0,0,0" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:resize-vertical">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:resize-horizontal">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:resize-both">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:resize-none">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:positive">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.inputBorderPositive}" />
      <Setter Property="Background" Value="{DynamicResource colors.inputFillPositive}" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.inputBorderError}" />
      <Setter Property="Background" Value="{DynamicResource colors.inputFillError}" />
    </Style>
    <Style Selector="^:is-focused">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.borderSelected}" />
      <Setter Property="Background" Value="{DynamicResource colors.inputFillActive}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.inputFillDisabled}" />
      <Setter Property="Background" Value="{DynamicResource colors.inputFillDisabled}" />
    </Style>
  </ControlTheme>
  <!-- InputContainer: BaseInput's box round the text and its icons: its fill and colour by state. -->
  <ControlTheme x:Key="Textarea.StyledInputContainer" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource colors.inputFill}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font300.fontFamily}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font300.fontSize}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font300.fontWeight}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font300.lineHeight}" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:positive">
      <Setter Property="Background" Value="{DynamicResource colors.inputFillPositive}" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="Background" Value="{DynamicResource colors.inputFillError}" />
    </Style>
    <Style Selector="^:is-focused">
      <Setter Property="Background" Value="{DynamicResource colors.inputFillActive}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.inputFillDisabled}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.inputTextDisabled}" />
    </Style>
    <Style Selector="^:size-large">
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font400.fontFamily}" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font400.fontSize}" />
      <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font400.fontWeight}" />
      <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font400.lineHeight}" />
    </Style>
    <Style Selector="^:size-compact">
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font200.fontFamily}" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font200.fontSize}" />
      <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font200.fontWeight}" />
      <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font200.lineHeight}" />
    </Style>
    <Style Selector="^:size-mini">
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font100.fontFamily}" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font100.fontSize}" />
      <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font100.fontWeight}" />
      <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font100.lineHeight}" />
    </Style>
  </ControlTheme>
  <!-- Input: the textarea: its padding and font by size, its colour, caret and placeholder by state, and which way it resizes. -->
  <ControlTheme x:Key="Textarea.StyledInput" TargetType="b:TextareaField">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="14,10,14,10" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource colors.inputPlaceholder}" />
    <Setter Property="Cursor" Value="Ibeam" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font300.fontFamily}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font300.fontSize}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font300.fontWeight}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font300.lineHeight}" />
    <Setter Property="Resize" Value="None" />
    <Style Selector="^:size-large">
      <Setter Property="Padding" Value="14,14,14,14" />
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font400.fontFamily}" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font400.fontSize}" />
      <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font400.fontWeight}" />
      <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font400.lineHeight}" />
    </Style>
    <Style Selector="^:size-compact">
      <Setter Property="Padding" Value="14,6,14,6" />
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font200.fontFamily}" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font200.fontSize}" />
      <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font200.fontWeight}" />
      <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font200.lineHeight}" />
    </Style>
    <Style Selector="^:size-mini">
      <Setter Property="Padding" Value="14,4,14,4" />
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.font100.fontFamily}" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.font100.fontSize}" />
      <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.font100.fontWeight}" />
      <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.font100.lineHeight}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.inputTextDisabled}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource colors.inputPlaceholderDisabled}" />
      <Setter Property="Cursor" Value="No" />
    </Style>
    <Style Selector="^:resize-vertical">
      <Setter Property="Resize" Value="Vertical" />
    </Style>
    <Style Selector="^:resize-horizontal">
      <Setter Property="Resize" Value="Horizontal" />
    </Style>
    <Style Selector="^:resize-both">
      <Setter Property="Resize" Value="Both" />
    </Style>
  </ControlTheme>
  <!-- Before: Base Web's Before, an app's content before the text: the input's InnerLeftContent. -->
  <ControlTheme x:Key="Textarea.StyledBefore" TargetType="ContentPresenter" />
  <!-- After: Base Web's After, an app's content after the icons: the input's InnerRightContent. -->
  <ControlTheme x:Key="Textarea.StyledAfter" TargetType="ContentPresenter" />
  <!-- ClearIconContainer: the clear icon's box, padded by size, its icon at the top. -->
  <ControlTheme x:Key="Textarea.StyledClearIconContainer" TargetType="Border">
    <Setter Property="Padding" Value="4,12,4,0" />
