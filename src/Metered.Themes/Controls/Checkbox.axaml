<!--
  Base Web's Checkbox (baseui 18.2.0, checkbox/checkbox.tsx: the v1 checkbox, with its toggle style),
  as a template of named parts. Each part's look is its own theme, Checkbox.Styled<Part>
  (Checkbox.Parts.g.axaml), which the checkbox's Overrides merge over: this file holds only the
  structure.

  Root                  (the flex line; the label goes first for the top and left placements)
    Checkmark           (the box: checkmarkType default)
    ToggleTrack         (checkmarkType toggle)
      Toggle
    Label               (only with content)
  Base Web's Input, the hidden native input, is the Checkbox itself here: it takes focus and keys.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">

  <ControlTheme x:Key="{x:Type b:Checkbox}" TargetType="b:Checkbox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <!-- Rings and shadows are drawn outside the marks: overflow visible. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <b:LabelPlacementPanel Name="Root" Theme="{DynamicResource Checkbox.StyledRoot}">
          <b:CheckboxMark Name="Checkmark" Theme="{DynamicResource Checkbox.StyledCheckmark}" />
          <Border Name="ToggleTrack" Theme="{DynamicResource Checkbox.StyledToggleTrack}">
            <b:CheckboxMark Name="Toggle" Theme="{DynamicResource Checkbox.StyledToggle}" />
          </Border>
          <ContentPresenter Name="Label"
                            Theme="{DynamicResource Checkbox.StyledLabel}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True" />
        </b:LabelPlacementPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
