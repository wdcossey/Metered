<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Root: the label element: the mark and the label in a row, the label first for the left placement; on a coarse pointer, padding for a 48 px target. -->
  <ControlTheme x:Key="Checkbox.StyledRoot" TargetType="b:RadioRootPanel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="LabelFirst" Value="False" />
    <Setter Property="AlignItems" Value="Start" />
    <Setter Property="Spacing" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:label-placement-left">
      <Setter Property="LabelFirst" Value="True" />
    </Style>
    <Style Selector="^:pointer-coarse">
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>
  <!-- CheckmarkContainer: the round-cornered plate behind the mark, tinted under a hovering mouse and while pressed. -->
  <ControlTheme x:Key="Checkbox.StyledCheckmarkContainer" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,8,8,8" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Style Selector="^:hover">
      <Setter Property="Background" Value="{DynamicResource colors.hoverOverlayAlpha}" />
    </Style>
    <Style Selector="^:error:hover">
      <Setter Property="Background" Value="{DynamicResource colors.hoverNegativeAlpha}" />
    </Style>
    <Style Selector="^:active">
      <Setter Property="Background" Value="{DynamicResource colors.pressedOverlayAlpha}" />
    </Style>
    <Style Selector="^:error:active">
      <Setter Property="Background" Value="{DynamicResource colors.pressedNegativeAlpha}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>
  <!-- Checkmark: the 17 px box, its colour in its border and fill; the tick or the dash, Base Web's background image; the focus outline on keyboard focus. -->
  <ControlTheme x:Key="Checkbox.StyledCheckmark" TargetType="b:CheckboxMark">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource colors.contentTertiary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="OutlineBrush" Value="{x:Null}" />
    <Setter Property="OutlineThickness" Value="0" />
    <Setter Property="OutlineOffset" Value="0" />
    <Setter Property="Glyph" Value="{x:Null}" />
    <Setter Property="GlyphSize" Value="17,17" />
    <Setter Property="GlyphViewBox" Value="0,0,24,24" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentInversePrimary}" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
          <BrushTransition Property="BorderBrush" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.borderSelected}" />
      <Setter Property="OutlineBrush" Value="{DynamicResource colors.brandBorderAccessible}" />
      <Setter Property="OutlineThickness" Value="2" />
      <Setter Property="OutlineOffset" Value="2" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.tagRedContentSecondary}" />
    </Style>
    <Style Selector="^:is-indeterminate">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Glyph" Value="m10 17.34-4.56-4.56 2.12-2.12L10 13.1l6.44-6.44 2.12 2.12L10 17.34Z" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:is-active">
      <Setter Property="Background" Value="{DynamicResource colors.pressedOverlayAlpha}" />
    </Style>
    <Style Selector="^:error:is-active">
      <Setter Property="Background" Value="{DynamicResource colors.pressedNegativeAlpha}" />
    </Style>
    <Style Selector="^:is-hovered">
      <Setter Property="Background" Value="{DynamicResource colors.hoverOverlayAlpha}" />
    </Style>
    <Style Selector="^:error:is-hovered">
      <Setter Property="Background" Value="{DynamicResource colors.hoverNegativeAlpha}" />
    </Style>
    <Style Selector="^:is-indeterminate">
      <Setter Property="Background" Value="{DynamicResource colors.contentPrimary}" />
      <Setter Property="Glyph" Value="M18 10.5H6v3h12v-3Z" />
    </Style>
    <Style Selector="^:is-indeterminate:error">
      <Setter Property="Background" Value="{DynamicResource colors.tagRedContentSecondary}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource colors.contentPrimary}" />
    </Style>
    <Style Selector="^:checked:error">
      <Setter Property="Background" Value="{DynamicResource colors.tagRedContentSecondary}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:is-indeterminate:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:checked:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
  </ControlTheme>
  <!-- Label: the checkbox's content, beside the mark. -->
  <ControlTheme x:Key="Checkbox.StyledLabel" TargetType="ContentPresenter">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="4,6,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphSmall.lineHeight}" />
    <Style Selector="^:label-placement-left">
      <Setter Property="Padding" Value="0,6,4,0" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
