  The themes of Checkbox's parts, Checkbox.Styled<Part>: each part's look by the state pseudoclasses
  the Checkbox mirrors onto it (Metered.Controls.Checkbox), the colours by token as Base Web's own
  style functions choose them, the lengths read from those functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Root: Base Web's label element, a flex line of the checkmark (or the toggle) and the label.
       Its whole box takes the pointer, as a label's does: the tap area is the row. -->
  <ControlTheme x:Key="Checkbox.StyledRoot" TargetType="b:LabelPlacementPanel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:label-top">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="AlignItems" Value="Center" />
    </Style>
    <Style Selector="^:label-right">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="AlignItems" Value="Start" />
    </Style>
    <Style Selector="^:label-bottom">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="AlignItems" Value="Center" />
    </Style>
    <Style Selector="^:label-left">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="AlignItems" Value="Start" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>
  <!-- Checkmark: the box, its tick or dash drawn as Base Web's background image (contained in the
       box inside its border, centred), and the outline keyboard focus gives a checked box. -->
  <ControlTheme x:Key="Checkbox.StyledCheckmark" TargetType="b:CheckboxMark">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="2,2,2,2" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="{DynamicResource borders.checkboxBorderRadius}" />
    <Setter Property="Background" Value="{DynamicResource colors.tickFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource colors.tickBorder}" />
    <Setter Property="Glyph" Value="{x:Null}" />
    <Setter Property="GlyphSize" Value="17,13" />
    <Setter Property="Foreground" Value="{DynamicResource colors.tickMarkFill}" />
    <Setter Property="OutlineThickness" Value="0" />
    <Setter Property="OutlineBrush" Value="{DynamicResource colors.borderAccent}" />
    <!-- The colours change over 200ms, once the box has loaded: CSS doesn't transition a first paint. -->
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" Easing="0.2,0.8,0.4,1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:hover">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillHover}" />
    </Style>
    <Style Selector="^:is-indeterminate">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillSelected}" />
      <Setter Property="GlyphSize" Value="14,4" />
    </Style>
    <Style Selector="^:is-indeterminate:hover">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillSelectedHover}" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillError}" />
      <Setter Property="Foreground" Value="{DynamicResource colors.tickMarkFillError}" />
    </Style>
    <Style Selector="^:error:hover">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorHover}" />
    </Style>
    <Style Selector="^:error:is-indeterminate">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorSelected}" />
    </Style>
    <Style Selector="^:error:is-indeterminate:hover">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorSelectedHover}" />
    </Style>
    <Style Selector="^:active">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillActive}" />
    </Style>
    <Style Selector="^:is-indeterminate:active">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillSelectedHoverActive}" />
    </Style>
    <Style Selector="^:error:active">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorHoverActive}" />
    </Style>
    <Style Selector="^:error:is-indeterminate:active">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorSelectedHoverActive}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillSelected}" />
      <Setter Property="Glyph" Value="M6.50002 12.6L0.400024 6.60002L2.60002 4.40002L6.50002 8.40002L13.9 0.900024L16.1 3.10002L6.50002 12.6Z" />
    </Style>
    <Style Selector="^:checked:hover">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillSelectedHover}" />
    </Style>
    <Style Selector="^:error:checked">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorSelected}" />
    </Style>
    <Style Selector="^:error:checked:hover">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorSelectedHover}" />
    </Style>
    <Style Selector="^:checked:active">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillSelectedHoverActive}" />
    </Style>
    <Style Selector="^:error:checked:active">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorSelectedHoverActive}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.tickFill}" />
      <Setter Property="Foreground" Value="{DynamicResource colors.tickMarkFillDisabled}" />
    </Style>
    <Style Selector="^:disabled:is-indeterminate">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillDisabled}" />
    </Style>
    <Style Selector="^:disabled:checked">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillDisabled}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.borderSelected}" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.borderNegative}" />
    </Style>
    <Style Selector="^:is-indeterminate">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Glyph" Value="M14 0.5H0V3.5H14V0.5Z" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.tickFillDisabled}" />
    </Style>
    <Style Selector="^:checked:focus-visible">
      <Setter Property="OutlineThickness" Value="3" />
    </Style>
  </ControlTheme>
  <!-- ToggleTrack: the rail the toggle runs on. -->
  <ControlTheme x:Key="Checkbox.StyledToggleTrack" TargetType="Border">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="6,6,4,4" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource colors.toggleTrackFill}" />
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.toggleTrackFillDisabled}" />
    </Style>
  </ControlTheme>
  <!-- Toggle: the knob, moved by its own width when checked. Its keyboard focus ring (Base Web's
       0 0 0 3px box-shadow) is drawn as an outline, which takes the theme's colour. Centred
       across the track and at its start: the track's alignItems: center. -->
  <ControlTheme x:Key="Checkbox.StyledToggle" TargetType="b:CheckboxMark">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource colors.toggleFill}" />
    <Setter Property="BoxShadow" Value="{DynamicResource lighting.shadow400}" />
    <Setter Property="OutlineThickness" Value="0" />
    <Setter Property="OutlineBrush" Value="{DynamicResource colors.borderAccent}" />
    <Setter Property="RenderTransform" Value="translateX(0px)" />
    <!-- transform 200ms, CSS's default ease; once loaded. -->
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="0.25,0.1,0.25,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource colors.toggleFillChecked}" />
      <Setter Property="RenderTransform" Value="translateX(20px)" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="Background" Value="{DynamicResource colors.toggleFill}" />
    </Style>
    <Style Selector="^:error:checked">
      <Setter Property="Background" Value="{DynamicResource colors.tickFillErrorSelected}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.toggleFillDisabled}" />
    </Style>
    <Style Selector="^:hover">
      <Setter Property="BoxShadow" Value="{DynamicResource lighting.shadow500}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="BoxShadow" Value="{DynamicResource lighting.shadow400}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="OutlineThickness" Value="3" />
    </Style>
  </ControlTheme>
  <!-- Label: LabelMedium on a 24 px line, padded on the side of the checkmark. -->
  <ControlTheme x:Key="Checkbox.StyledLabel" TargetType="ContentPresenter">
    <Setter Property="FontFamily" Value="{DynamicResource typography.LabelMedium.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.LabelMedium.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.LabelMedium.fontWeight}" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Style Selector="^:label-top">
      <Setter Property="Padding" Value="0,0,0,8" />
    </Style>
    <Style Selector="^:label-right">
      <Setter Property="Padding" Value="8,0,0,0" />
    </Style>
    <Style Selector="^:label-bottom">
      <Setter Property="Padding" Value="0,8,0,0" />
    </Style>
    <Style Selector="^:label-left">
      <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
