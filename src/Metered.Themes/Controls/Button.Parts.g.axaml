  <!-- StartEnhancer and EndEnhancer: flex boxes beside the content. -->
  <ControlTheme x:Key="Button.StyledStartEnhancer" TargetType="ContentPresenter">
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>
  <ControlTheme x:Key="Button.StyledEndEnhancer" TargetType="ContentPresenter">
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>
  <!-- StartEnhancerButtonContentContainer: the start enhancer and the content, centred, taking the room the end enhancer leaves. -->
  <ControlTheme x:Key="Button.StyledStartEnhancerButtonContentContainer" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>
  <!-- LoadingSpinnerContainer: holds the spinner, in place of the content while loading. -->
  <ControlTheme x:Key="Button.StyledLoadingSpinnerContainer" TargetType="Panel">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style Selector="^:size-xsmall">
      <Setter Property="Margin" Value="0,2,0,2" />
    </Style>
    <Style Selector="^:size-small">
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
    <Style Selector="^:size-medium">
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
    <Style Selector="^:size-large">
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
    <Style Selector="^:is-loading">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
  <!-- LoadingSpinner: the ring, turning once each 700 ms. -->
  <ControlTheme x:Key="Button.StyledLoadingSpinner" TargetType="b:ButtonLoadingSpinner">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Style Selector="^:size-xsmall">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Thickness" Value="2" />
    </Style>
    <Style Selector="^:size-small">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Thickness" Value="2" />
    </Style>
    <Style Selector="^:size-medium">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Thickness" Value="2" />
    </Style>
    <Style Selector="^:size-large">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Thickness" Value="2" />
    </Style>
    <Style Selector="^:kind-primary">
      <Setter Property="Foreground" Value="{DynamicResource colors.buttonPrimarySpinnerForeground}" />
      <Setter Property="Background" Value="{DynamicResource colors.buttonPrimarySpinnerBackground}" />
    </Style>
    <Style Selector="^:kind-secondary">
      <Setter Property="Foreground" Value="{DynamicResource colors.buttonSecondarySpinnerForeground}" />
      <Setter Property="Background" Value="{DynamicResource colors.buttonSecondarySpinnerBackground}" />
    </Style>
    <Style Selector="^:kind-tertiary">
      <Setter Property="Foreground" Value="{DynamicResource colors.buttonTertiarySpinnerForeground}" />
      <Setter Property="Background" Value="{DynamicResource colors.buttonTertiarySpinnerBackground}" />
    </Style>
    <Style Selector="^:kind-dangerPrimary">
      <Setter Property="Foreground" Value="{DynamicResource colors.buttonDangerPrimarySpinnerForeground}" />
      <Setter Property="Background" Value="{DynamicResource colors.buttonDangerPrimarySpinnerBackground}" />
    </Style>
    <Style Selector="^:kind-dangerSecondary">
      <Setter Property="Foreground" Value="{DynamicResource colors.buttonDangerSecondarySpinnerForeground}" />
      <Setter Property="Background" Value="{DynamicResource colors.buttonDangerSecondarySpinnerBackground}" />
    </Style>
    <Style Selector="^:kind-dangerTertiary">
      <Setter Property="Foreground" Value="{DynamicResource colors.buttonDangerTertiarySpinnerForeground}" />
      <Setter Property="Background" Value="{DynamicResource colors.buttonDangerTertiarySpinnerBackground}" />
    </Style>
    <Style Selector="^:kind-outline">
      <Setter Property="Foreground" Value="{DynamicResource colors.buttonOutlineSpinnerForeground}" />
      <Setter Property="Background" Value="{DynamicResource colors.buttonOutlineSpinnerBackground}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource colors.buttonDisabledSpinnerForeground}" />
      <Setter Property="Background" Value="{DynamicResource colors.buttonDisabledSpinnerBackground}" />
    </Style>
    <Style Selector="^:is-loading">
      <Style.Animations>
        <Animation Duration="0:0:0.7" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
