<!--
  Generated by tools/tokens/gen.js (tools/tokens/slider.js) from baseui 18.2.0
  (© Uber Technologies, Inc., MIT). Do not edit.
  The themes of Slider's parts, Slider.Styled<Part>, from Base Web's slider: each part's look by the state
  pseudoclasses the Slider sets on it (Metered.Controls.Slider), the colours by token, the lengths read from
  Base Web's own style functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Root: the slider's box: the track, then the tick bar. -->
  <ControlTheme x:Key="Slider.StyledRoot" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </ControlTheme>
  <!-- Track: the band that takes a press: padded round the inner track, the cursor by state. -->
  <ControlTheme x:Key="Slider.StyledTrack" TargetType="Border">
    <Setter Property="Padding" Value="16,16,16,16" />
    <Setter Property="Background" Value="{DynamicResource colors.sliderTrackFill}" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:range">
      <Setter Property="Cursor" Value="{Binding $parent[InputElement].Cursor}" />
    </Style>
    <Style Selector="^:is-dragged">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>
  <!-- InnerTrack: the 2 px line: the selection (from the start to the thumb, or between two) and the rest, by state; it places the marks and thumbs. -->
  <ControlTheme x:Key="Slider.StyledInnerTrack" TargetType="b:SliderInnerTrack">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource colors.borderOpaque}" />
    <Setter Property="Fill" Value="{DynamicResource colors.borderSelected}" />
    <Setter Property="Cursor" Value="{Binding $parent[InputElement].Cursor}" />
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.borderStateDisabled}" />
      <Setter Property="Fill" Value="{DynamicResource colors.borderOpaque}" />
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>
  <!-- Mark: a gap in the line at each step, with marks. -->
  <ControlTheme x:Key="Slider.StyledMark" TargetType="Border">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="2" />
    <Setter Property="Background" Value="{DynamicResource colors.backgroundPrimary}" />
  </ControlTheme>
  <!-- Thumb: a round handle: its fill by state, its shadow, or on keyboard focus a ring. -->
  <ControlTheme x:Key="Slider.StyledThumb" TargetType="b:SliderThumb">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Background" Value="{DynamicResource colors.sliderHandleFill}" />
    <Setter Property="BoxShadow" Value="{DynamicResource slider.boxShadow.thumb}" />
    <Setter Property="OutlineBrush" Value="{x:Null}" />
    <Setter Property="OutlineThickness" Value="0" />
    <Setter Property="OutlineOffset" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.sliderHandleFillDisabled}" />
      <Setter Property="Cursor" Value="{Binding $parent[InputElement].Cursor}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="OutlineBrush" Value="{DynamicResource colors.borderAccent}" />
      <Setter Property="OutlineThickness" Value="3" />
    </Style>
  </ControlTheme>
  <!-- ThumbValue: the value above a hovered or dragged thumb. -->
  <ControlTheme x:Key="Slider.StyledThumbValue" TargetType="ContentPresenter">
    <Setter Property="Canvas.Top" Value="-56" />
    <Setter Property="Background" Value="{DynamicResource colors.sliderHandleInnerFill}" />
    <Setter Property="Padding" Value="16,12,16,12" />
    <Setter Property="CornerRadius" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentInversePrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphSmall.lineHeight}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.sliderHandleFillDisabled}" />
    </Style>
  </ControlTheme>
  <!-- InnerThumb: the stem from the value down into the thumb. -->
  <ControlTheme x:Key="Slider.StyledInnerThumb" TargetType="Border">
    <Setter Property="Canvas.Top" Value="-16" />
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Background" Value="{DynamicResource colors.sliderHandleInnerFill}" />
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.sliderHandleFillDisabled}" />
    </Style>
  </ControlTheme>
  <!-- TickBar: the row of the two ticks under the track. -->
  <ControlTheme x:Key="Slider.StyledTickBar" TargetType="Border">
    <Setter Property="Padding" Value="16,0,16,10" />
  </ControlTheme>
  <!-- Tick: the minimum and the maximum, as labels. -->
  <ControlTheme x:Key="Slider.StyledTick" TargetType="ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphSmall.lineHeight}" />
  </ControlTheme>
</ResourceDictionary>
