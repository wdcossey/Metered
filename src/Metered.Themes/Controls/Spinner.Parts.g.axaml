    <Style Selector="^:border-width-pixels">
      <Setter Property="Thickness" Value="{Binding $parent[b:Spinner].BorderWidth.Pixels}" />
    </Style>
    <Style Selector="^:border-width-invalid">
      <Setter Property="Thickness" Value="3" />
    </Style>
    <Style Selector="^:has-color">
