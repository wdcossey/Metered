  The theme of Spinner's part, Spinner.StyledSpinner, from Base Web's spinner: the box, the border and the top's
  colour by the state pseudoclasses the Spinner sets on it (Metered.Controls.Spinner), the colours by token, the
  lengths read from Base Web's own style function.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Spinner: the ring, its border outside its box (CSS's content box: Base Web sets no box-sizing), turning once a second. -->
  <ControlTheme x:Key="Spinner.StyledSpinner" TargetType="b:SpinnerRing">
    <Setter Property="BoxSize" Value="32" />
    <Setter Property="Thickness" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentAccent}" />
    <Setter Property="Background" Value="{DynamicResource colors.backgroundTertiary}" />
    <Setter Property="Cursor" Value="Wait" />
    <Style Selector="^:not(:metered-still)">
      <Style.Animations>
        <Animation Duration="00:00:01.000" IterationCount="Infinite" Easing="LinearEasing">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:size-small">
      <Setter Property="BoxSize" Value="24" />
    </Style>
    <Style Selector="^:size-large">
      <Setter Property="BoxSize" Value="40" />
    </Style>
    <Style Selector="^:size-scale0">
      <Setter Property="BoxSize" Value="2" />
    </Style>
    <Style Selector="^:size-scale100">
      <Setter Property="BoxSize" Value="4" />
    </Style>
    <Style Selector="^:size-scale200">
      <Setter Property="BoxSize" Value="6" />
    </Style>
    <Style Selector="^:size-scale300">
      <Setter Property="BoxSize" Value="8" />
    </Style>
    <Style Selector="^:size-scale400">
      <Setter Property="BoxSize" Value="10" />
    </Style>
    <Style Selector="^:size-scale500">
      <Setter Property="BoxSize" Value="12" />
    </Style>
    <Style Selector="^:size-scale550">
      <Setter Property="BoxSize" Value="14" />
    </Style>
    <Style Selector="^:size-scale600">
      <Setter Property="BoxSize" Value="16" />
    </Style>
    <Style Selector="^:size-scale650">
      <Setter Property="BoxSize" Value="18" />
    </Style>
    <Style Selector="^:size-scale700">
      <Setter Property="BoxSize" Value="20" />
    </Style>
    <Style Selector="^:size-scale750">
      <Setter Property="BoxSize" Value="22" />
    </Style>
    <Style Selector="^:size-scale800">
      <Setter Property="BoxSize" Value="24" />
    </Style>
    <Style Selector="^:size-scale850">
      <Setter Property="BoxSize" Value="28" />
    </Style>
    <Style Selector="^:size-scale950">
      <Setter Property="BoxSize" Value="36" />
    </Style>
    <Style Selector="^:size-scale1000">
      <Setter Property="BoxSize" Value="40" />
    </Style>
    <Style Selector="^:size-scale1200">
      <Setter Property="BoxSize" Value="48" />
    </Style>
    <Style Selector="^:size-scale1400">
      <Setter Property="BoxSize" Value="56" />
    </Style>
    <Style Selector="^:size-scale1600">
      <Setter Property="BoxSize" Value="64" />
    </Style>
    <Style Selector="^:size-scale2400">
      <Setter Property="BoxSize" Value="96" />
    </Style>
    <Style Selector="^:size-scale3200">
      <Setter Property="BoxSize" Value="128" />
    </Style>
    <Style Selector="^:size-scale4800">
      <Setter Property="BoxSize" Value="192" />
    </Style>
    <Style Selector="^:size-pixels">
      <Setter Property="BoxSize" Value="{Binding $parent[b:Spinner].Size.Pixels}" />
    </Style>
    <Style Selector="^:size-invalid">
      <Setter Property="BoxSize" Value="NaN" />
    </Style>
    <Style Selector="^:border-width-small">
      <Setter Property="Thickness" Value="2" />
