<!--
  Generated by tools/tokens/gen.js (tools/tokens/menu.js) from baseui 18.2.0
  (© Uber Technologies, Inc., MIT). Do not edit.
  The themes of Menu's parts, Menu.Styled<Part>, from Base Web's menu: each part's look by the state
  pseudoclasses the Menu and its options set on it (Metered.Controls.Menu), the colours, radii, shadows and
  border colours by token, the lengths read from Base Web's own style functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- List: the list's box: its fill, radius and shadow, its padding inside its scroller, its outline while focused by keyboard. -->
  <ControlTheme x:Key="Menu.StyledList" TargetType="b:MenuList">
    <Setter Property="Background" Value="{DynamicResource colors.menuFill}" />
    <Setter Property="CornerRadius" Value="{DynamicResource borders.popoverBorderRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource lighting.shadow600}" />
    <Setter Property="Padding" Value="0,8,0,8" />
    <Setter Property="OutlineBrush" Value="{x:Null}" />
    <Setter Property="OutlineThickness" Value="0" />
    <Style Selector="^:focus-visible">
      <Setter Property="OutlineBrush" Value="{DynamicResource colors.borderAccent}" />
      <Setter Property="OutlineThickness" Value="3" />
    </Style>
  </ControlTheme>
  <!-- ListItem: an option: its padding and type by size, its colours by the highlight, the menu's focus and disabled. -->
  <ControlTheme x:Key="Menu.StyledListItem" TargetType="ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="16,8,16,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource colors.menuFontDefault}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphSmall.lineHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
          <BrushTransition Property="Background" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:size-compact">
      <Setter Property="Padding" Value="32,4,32,4" />
      <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphXSmall.fontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphXSmall.fontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphXSmall.fontWeight}" />
      <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphXSmall.lineHeight}" />
    </Style>
    <Style Selector="^:is-highlighted">
      <Setter Property="Background" Value="{DynamicResource colors.menuFillHover}" />
      <Setter Property="Foreground" Value="{DynamicResource colors.menuFontSelected}" />
    </Style>
    <Style Selector="^:is-disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="No" />
    </Style>
    <Style Selector="^:is-highlighted:is-focused">
      <Setter Property="Foreground" Value="{DynamicResource colors.menuFontHighlighted}" />
    </Style>
    <Style Selector="^:is-disabled">
      <Setter Property="Foreground" Value="{DynamicResource colors.menuFontDisabled}" />
    </Style>
  </ControlTheme>
  <!-- ListItemAnchor: an href option's label, as a link: the default colour whatever the option's state, underlined. -->
  <ControlTheme x:Key="Menu.StyledListItemAnchor" TargetType="ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource colors.menuFontDefault}" />
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </ControlTheme>
  <!-- OptgroupHeader: a group's header. -->
  <ControlTheme x:Key="Menu.StyledOptgroupHeader" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="8,6,8,6" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.LabelSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.LabelSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.LabelSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.LabelSmall.lineHeight}" />
  </ControlTheme>
  <!-- MenuDivider: a divider: a line of the theme's border300, inset. -->
  <ControlTheme x:Key="Menu.StyledMenuDivider" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource borders.border300.borderColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Margin" Value="12,4,12,4" />
  </ControlTheme>
  <!-- EmptyState: the message of an empty menu. -->
  <ControlTheme x:Key="Menu.StyledEmptyState" TargetType="ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="24,24,24,24" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource colors.menuFontDisabled}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphSmall.lineHeight}" />
    <Setter Property="Cursor" Value="No" />
  </ControlTheme>
  <!-- ListItemProfile: a profile option: its padding, tinted under a hovering mouse. -->
  <ControlTheme x:Key="Menu.StyledListItemProfile" TargetType="Border">
    <Setter Property="Padding" Value="24,8,24,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:hover">
      <Setter Property="Background" Value="{DynamicResource colors.menuFillHover}" />
    </Style>
  </ControlTheme>
  <!-- ProfileImgContainer: the profile's image box. -->
  <ControlTheme x:Key="Menu.StyledProfileImgContainer" TargetType="Border">
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="60" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>
  <!-- ProfileImg: the profile's image, round. -->
  <ControlTheme x:Key="Menu.StyledProfileImg" TargetType="Border">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="30" />
  </ControlTheme>
  <!-- ProfileLabelsContainer: the profile's title, subtitle and body, in a column. -->
  <ControlTheme x:Key="Menu.StyledProfileLabelsContainer" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </ControlTheme>
  <!-- ProfileTitle: the profile's title. -->
  <ControlTheme x:Key="Menu.StyledProfileTitle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.LabelMedium.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.LabelMedium.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.LabelMedium.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.LabelMedium.lineHeight}" />
  </ControlTheme>
  <!-- ProfileSubtitle: the profile's subtitle. -->
  <ControlTheme x:Key="Menu.StyledProfileSubtitle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphSmall.lineHeight}" />
  </ControlTheme>
  <!-- ProfileBody: the profile's body. -->
  <ControlTheme x:Key="Menu.StyledProfileBody" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphXSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphXSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphXSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphXSmall.lineHeight}" />
  </ControlTheme>
</ResourceDictionary>
