    <Style Selector="^:size-compact:multi:has-value:type-search">
      <Setter Property="Padding" Value="36,2,0,2" />
    </Style>
    <Style Selector="^:size-mini">
      <Setter Property="Padding" Value="10,4,0,4" />
    </Style>
    <Style Selector="^:size-mini:multi:has-value">
      <Setter Property="Padding" Value="8,0,0,0" />
    </Style>
    <Style Selector="^:size-mini:type-search">
      <Setter Property="Padding" Value="38,4,0,4" />
    </Style>
    <Style Selector="^:size-mini:multi:has-value:type-search">
      <Setter Property="Padding" Value="36,0,0,0" />
    </Style>
