<!--
  Generated by tools/tokens/gen.js (tools/tokens/progress-bar.js) from baseui 18.2.0
  (© Uber Technologies, Inc., MIT). Do not edit.
  The themes of ProgressBar's parts, ProgressBar.Styled<Part>, from Base Web's progress bar: each part's
  look by the state pseudoclasses the ProgressBar mirrors onto it (Metered.Controls.ProgressBar), the
  colours by token, the lengths and the motion read from Base Web's own style functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Root: the bar and its label, in a column. -->
  <ControlTheme x:Key="ProgressBar.StyledRoot" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Spacing" Value="8" />
  </ControlTheme>
  <!-- BarContainer: the bars in a row, an equal share each after their margins (ProgressBarContainer). -->
  <ControlTheme x:Key="ProgressBar.StyledBarContainer" TargetType="b:ProgressBarContainer" />
  <!-- Bar: a step's track, its fill clipped to its rounded corners; after the first, a margin between steps. -->
  <ControlTheme x:Key="ProgressBar.StyledBar" TargetType="Border">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource colors.backgroundTertiary}" />
    <Setter Property="Height" Value="4" />
    <Setter Property="Margin" Value="0" />
    <Style Selector="^:size-large">
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="^:size-small">
      <Setter Property="Height" Value="2" />
    </Style>
    <Style Selector="^:stepped">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^:stepped:nth-child(1)">
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
  </ControlTheme>
  <!-- BarProgress: the fill: the intent's colour, moved along its bar by the value (the ProgressBar's) or by its step's state; the step in progress slides in and fades. -->
  <ControlTheme x:Key="ProgressBar.StyledBarProgress" TargetType="b:ProgressBarFill">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource colors.backgroundAccent}" />
    <Setter Property="Offset" Value="-100" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Offset" Duration="00:00:00.500" Easing="0.25,0.1,0.25,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:stepped:step-in-progress:not(:metered-still)">
      <Style.Animations>
        <Animation Duration="00:00:02.100" IterationCount="Infinite" Easing="0,0,1,1">
            <KeyFrame Cue="0%">
              <Setter Property="Offset" Value="-102" />
              <Setter Property="Opacity" Value="1" />
            </KeyFrame>
            <KeyFrame Cue="50%">
              <Setter Property="Offset" Value="0" />
              <Setter Property="Opacity" Value="1" />
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="Offset" Value="0" />
              <Setter Property="Opacity" Value="0" />
            </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:intent-brand">
      <Setter Property="Background" Value="{DynamicResource colors.brandBorderAccessible}" />
    </Style>
    <Style Selector="^:intent-negative">
      <Setter Property="Background" Value="{DynamicResource colors.contentNegative}" />
    </Style>
    <Style Selector="^:intent-warning">
      <Setter Property="Background" Value="{DynamicResource colors.contentWarning}" />
    </Style>
    <Style Selector="^:intent-positive">
      <Setter Property="Background" Value="{DynamicResource colors.contentPositive}" />
    </Style>
    <Style Selector="^:intent-default">
      <Setter Property="Background" Value="{DynamicResource colors.contentAccent}" />
    </Style>
    <Style Selector="^:stepped">
      <Setter Property="Offset" Value="-102" />
    </Style>
    <Style Selector="^:stepped:step-completed">
      <Setter Property="Offset" Value="0" />
    </Style>
    <Style Selector="^:stepped:step-in-progress">
      <Setter Property="Offset" Value="-102" />
    </Style>
  </ControlTheme>
  <!-- InfiniteBar: a half of the infinite bar: a gradient three times its width, swept across it, the outer corners rounded. -->
  <ControlTheme x:Key="ProgressBar.StyledInfiniteBar" TargetType="b:ProgressBarInfiniteBar">
    <Setter Property="CornerRadius" Value="0,2,2,0" />
    <Setter Property="Height" Value="4" />
    <Setter Property="ImageSize" Value="300" />
    <Setter Property="Position" Value="150" />
    <Setter Property="Fill" Value="{DynamicResource colors.backgroundAccent}" />
    <Setter Property="FillStart" Value="25" />
    <Setter Property="FillEnd" Value="75" />
    <Style Selector="^:is-left:not(:metered-still)">
      <Style.Animations>
        <Animation Duration="00:00:01.500" IterationCount="Infinite" Easing="0,0,1,1">
            <KeyFrame Cue="0%">
              <Setter Property="Position" Value="-50" />
            </KeyFrame>
            <KeyFrame Cue="33%">
              <Setter Property="Position" Value="50" />
            </KeyFrame>
            <KeyFrame Cue="66%">
              <Setter Property="Position" Value="50" />
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="Position" Value="150" />
            </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:not(:is-left):not(:metered-still)">
      <Style.Animations>
        <Animation Duration="00:00:01.500" IterationCount="Infinite" Easing="0,0,1,1">
            <KeyFrame Cue="0%">
              <Setter Property="Position" Value="150" />
            </KeyFrame>
            <KeyFrame Cue="33%">
              <Setter Property="Position" Value="50" />
            </KeyFrame>
            <KeyFrame Cue="66%">
              <Setter Property="Position" Value="50" />
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="Position" Value="-50" />
            </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:is-left">
      <Setter Property="CornerRadius" Value="2,0,0,2" />
      <Setter Property="Position" Value="-50" />
    </Style>
    <Style Selector="^:size-large">
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="^:size-small">
      <Setter Property="Height" Value="2" />
    </Style>
    <Style Selector="^:intent-brand">
      <Setter Property="Fill" Value="{DynamicResource colors.brandBorderAccessible}" />
    </Style>
    <Style Selector="^:intent-negative">
      <Setter Property="Fill" Value="{DynamicResource colors.contentNegative}" />
    </Style>
    <Style Selector="^:intent-warning">
      <Setter Property="Fill" Value="{DynamicResource colors.contentWarning}" />
    </Style>
    <Style Selector="^:intent-positive">
      <Setter Property="Fill" Value="{DynamicResource colors.contentPositive}" />
    </Style>
    <Style Selector="^:intent-default">
      <Setter Property="Fill" Value="{DynamicResource colors.contentAccent}" />
    </Style>
  </ControlTheme>
  <!-- Label: the progress label, centred under the bar. -->
  <ControlTheme x:Key="ProgressBar.StyledLabel" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Padding" Value="16,0,16,0" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.LabelMedium.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.LabelMedium.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.LabelMedium.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.LabelMedium.lineHeight}" />
    <Style Selector="^:size-large">
      <Setter Property="FontFamily" Value="{DynamicResource typography.LabelLarge.fontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource typography.LabelLarge.fontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource typography.LabelLarge.fontWeight}" />
      <Setter Property="LineHeight" Value="{DynamicResource typography.LabelLarge.lineHeight}" />
    </Style>
    <Style Selector="^:size-small">
      <Setter Property="FontFamily" Value="{DynamicResource typography.LabelSmall.fontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource typography.LabelSmall.fontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource typography.LabelSmall.fontWeight}" />
      <Setter Property="LineHeight" Value="{DynamicResource typography.LabelSmall.lineHeight}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
