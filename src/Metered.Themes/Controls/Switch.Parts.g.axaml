  state pseudoclasses the Switch mirrors onto it (Metered.Controls.Switch), the colours by token, the
  lengths read from Base Web's own style functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Root: the label element: a row, the label before the track for the left placement; on a coarse pointer, padding for a 48 px target. -->
  <ControlTheme x:Key="Switch.StyledRoot" TargetType="b:RadioRootPanel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="LabelFirst" Value="False" />
    <Setter Property="AlignItems" Value="Start" />
    <Setter Property="Spacing" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:label-placement-left">
      <Setter Property="LabelFirst" Value="True" />
    </Style>
    <Style Selector="^:size-default:pointer-coarse">
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="^:size-small:pointer-coarse">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>
  <!-- ToggleTrack: the rounded track: its fill, its border (none when checked and enabled), the hover overlay and the focus outline. -->
  <ControlTheme x:Key="Switch.StyledToggleTrack" TargetType="b:RadioMark">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{DynamicResource colors.backgroundTertiary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource colors.contentTertiary}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Overlay" Value="{x:Null}" />
    <Setter Property="OutlineBrush" Value="{x:Null}" />
    <Setter Property="OutlineThickness" Value="0" />
    <Setter Property="OutlineOffset" Value="0" />
    <Style Selector="^:size-small">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^:not(:checked):disabled">
      <Setter Property="Background" Value="{DynamicResource colors.backgroundStateDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource colors.borderStateDisabled}" />
    </Style>
    <Style Selector="^:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource colors.backgroundInversePrimary}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:checked:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.backgroundStateDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource colors.borderStateDisabled}" />
    </Style>
    <Style Selector="^:not(:checked):is-hovered">
      <Setter Property="Overlay" Value="{DynamicResource colors.hoverOverlayAlpha}" />
    </Style>
    <Style Selector="^:checked:is-hovered">
      <Setter Property="Overlay" Value="{DynamicResource colors.hoverOverlayInverseAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):focus-visible">
      <Setter Property="OutlineBrush" Value="{DynamicResource colors.brandBorderAccessible}" />
      <Setter Property="OutlineThickness" Value="2" />
      <Setter Property="OutlineOffset" Value="2" />
    </Style>
  </ControlTheme>
  <!-- Toggle: the knob: its size and fill by state, moved along the track when checked, the hover overlay, and the checkmark with showIcon. -->
  <ControlTheme x:Key="Switch.StyledToggle" TargetType="b:SwitchToggle">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Background" Value="{DynamicResource colors.contentTertiary}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Overlay" Value="{x:Null}" />
    <Setter Property="RenderTransform" Value="translateX(0px)" />
    <Setter Property="Icon" Value="{x:Null}" />
    <Setter Property="IconBrush" Value="{x:Null}" />
    <Setter Property="IconSize" Value="0" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.350" Easing="0.27,1.06,0.18,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:not(:checked):size-small">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="^:checked:size-default">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="RenderTransform" Value="translateX(20px)" />
    </Style>
    <Style Selector="^:not(:checked):disabled">
      <Setter Property="Background" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource colors.contentInversePrimary}" />
    </Style>
    <Style Selector="^:checked:disabled">
      <Setter Property="Background" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:not(:checked):is-hovered">
      <Setter Property="Overlay" Value="{DynamicResource colors.hoverOverlayInverseAlpha}" />
    </Style>
    <Style Selector="^:checked:is-hovered">
      <Setter Property="Overlay" Value="{DynamicResource colors.hoverOverlayAlpha}" />
    </Style>
    <Style Selector="^:checked:size-small">
      <Setter Property="RenderTransform" Value="translateX(16px)" />
    </Style>
    <Style Selector="^:checked:show-icon">
      <Setter Property="Icon" Value="m8.5 19.84-6.56-6.56 2.12-2.12L8.5 15.6 19.94 4.16l2.12 2.12L8.5 19.84Z" />
      <Setter Property="IconBrush" Value="{DynamicResource colors.contentPrimary}" />
    </Style>
    <Style Selector="^:checked:size-default:show-icon">
      <Setter Property="IconSize" Value="16" />
    </Style>
    <Style Selector="^:checked:size-small:show-icon">
      <Setter Property="IconSize" Value="12" />
    </Style>
  </ControlTheme>
  <!-- Label: the switch's content, beside the track. -->
  <ControlTheme x:Key="Switch.StyledLabel" TargetType="Border">
    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="8,4,0,0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.ParagraphMedium.fontFamily}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.ParagraphMedium.fontSize}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.ParagraphMedium.fontWeight}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.ParagraphMedium.lineHeight}" />
    <Style Selector="^:size-default:label-placement-left">
      <Setter Property="Padding" Value="0,4,8,0" />
    </Style>
    <Style Selector="^:size-small:label-placement-right">
      <Setter Property="Padding" Value="8,2,0,0" />
    </Style>
    <Style Selector="^:size-small:label-placement-left">
      <Setter Property="Padding" Value="0,2,8,0" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:size-small">
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.ParagraphSmall.fontFamily}" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.ParagraphSmall.fontSize}" />
      <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.ParagraphSmall.fontWeight}" />
      <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.ParagraphSmall.lineHeight}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
