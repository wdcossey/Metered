<!--
  Generated by tools/tokens/gen.js (tools/tokens/radio.js) from baseui 18.2.0
  (© Uber Technologies, Inc., MIT). Do not edit.
  The themes of Radio's parts, Radio.Styled<Part>, from Base Web's radio-v2: each part's look by the
  state pseudoclasses the Radio mirrors onto it (Metered.Controls.Radio), the colours by token, the
  lengths read from Base Web's own style functions.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="https://github.com/wdcossey/Metered">
  <!-- Root: the label element: a row or a column by label placement, the label wrapper before the backplate for top and left; on a coarse pointer, padding for a 48 px target. -->
  <ControlTheme x:Key="Radio.StyledRoot" TargetType="b:RadioRootPanel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="LabelFirst" Value="False" />
    <Setter Property="AlignItems" Value="Start" />
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:label-placement-top">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="LabelFirst" Value="True" />
      <Setter Property="AlignItems" Value="Center" />
    </Style>
    <Style Selector="^:label-placement-bottom">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="AlignItems" Value="Center" />
    </Style>
    <Style Selector="^:label-placement-left">
      <Setter Property="LabelFirst" Value="True" />
    </Style>
    <Style Selector="^:pointer-coarse">
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>
  <!-- RadioBackplate: the round-cornered plate behind the mark, tinted under a hovering mouse and while pressed. -->
  <ControlTheme x:Key="Radio.StyledRadioBackplate" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,8,8,8" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Style Selector="^:not(:disabled):not(:error):not(:hover):active">
      <Setter Property="Background" Value="{DynamicResource colors.pressedOverlayAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):not(:error):hover:not(:active)">
      <Setter Property="Background" Value="{DynamicResource colors.hoverOverlayAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):not(:error):hover:active">
      <Setter Property="Background" Value="{DynamicResource colors.pressedOverlayAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):error:not(:hover):active">
      <Setter Property="Background" Value="{DynamicResource colors.pressedNegativeAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):error:hover:not(:active)">
      <Setter Property="Background" Value="{DynamicResource colors.hoverNegativeAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):error:hover:active">
      <Setter Property="Background" Value="{DynamicResource colors.pressedNegativeAlpha}" />
    </Style>
  </ControlTheme>
  <!-- RadioMarkOuter: the 17 px disc, its colour in its border and fill; the focus outline when checked and focused by keyboard. -->
  <ControlTheme x:Key="Radio.StyledRadioMarkOuter" TargetType="b:RadioMark">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="CornerRadius" Value="8.5" />
    <Setter Property="OutlineBrush" Value="{x:Null}" />
    <Setter Property="OutlineThickness" Value="0" />
    <Setter Property="OutlineOffset" Value="0" />
    <Style Selector="^:not(:disabled):error">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.tagRedBorderSecondarySelected}" />
      <Setter Property="Background" Value="{DynamicResource colors.tagRedBorderSecondarySelected}" />
    </Style>
    <Style Selector="^:disabled:not(:error)">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.contentStateDisabled}" />
      <Setter Property="Background" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:disabled:error">
      <Setter Property="BorderBrush" Value="{DynamicResource colors.contentStateDisabled}" />
      <Setter Property="Background" Value="{DynamicResource colors.contentStateDisabled}" />
    </Style>
    <Style Selector="^:checked:focus-visible">
      <Setter Property="OutlineBrush" Value="{DynamicResource colors.brandBorderAccessible}" />
      <Setter Property="OutlineThickness" Value="2" />
      <Setter Property="OutlineOffset" Value="2" />
    </Style>
  </ControlTheme>
  <!-- RadioMarkInner: the disc inside: the whole inside unchecked, a 5 px dot checked; the hover and press overlay. -->
  <ControlTheme x:Key="Radio.StyledRadioMarkInner" TargetType="b:RadioMark">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Background" Value="{DynamicResource colors.contentInversePrimary}" />
    <Setter Property="CornerRadius" Value="6.5" />
    <Setter Property="Overlay" Value="{x:Null}" />
    <Style Selector="^:loaded">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
          <DoubleTransition Property="Height" Duration="00:00:00.200" Easing="0.2,0.8,0.4,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
    </Style>
    <Style Selector="^:not(:disabled):not(:error):not(:is-hovered):is-active">
      <Setter Property="Overlay" Value="{DynamicResource colors.pressedOverlayAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):not(:error):is-hovered:not(:is-active)">
      <Setter Property="Overlay" Value="{DynamicResource colors.hoverOverlayAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):not(:error):is-hovered:is-active">
      <Setter Property="Overlay" Value="{DynamicResource colors.hoverOverlayAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):error:not(:is-hovered):is-active">
      <Setter Property="Overlay" Value="{DynamicResource colors.pressedNegativeAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):error:is-hovered:not(:is-active)">
      <Setter Property="Overlay" Value="{DynamicResource colors.hoverNegativeAlpha}" />
    </Style>
    <Style Selector="^:not(:disabled):error:is-hovered:is-active">
      <Setter Property="Overlay" Value="{DynamicResource colors.hoverNegativeAlpha}" />
    </Style>
  </ControlTheme>
  <!-- LabelWrapper: the label and the description, in a column. -->
  <ControlTheme x:Key="Radio.StyledLabelWrapper" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="MaxWidth" Value="Infinity" />
    <Style Selector="^:label-placement-top">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^:label-placement-bottom">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^:align-horizontal">
      <Setter Property="MaxWidth" Value="240" />
    </Style>
  </ControlTheme>
  <!-- Label: the radio's content. -->
  <ControlTheme x:Key="Radio.StyledLabel" TargetType="Border">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentPrimary}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource typography.LabelSmall.fontFamily}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource typography.LabelSmall.fontSize}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource typography.LabelSmall.fontWeight}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource typography.LabelSmall.lineHeight}" />
    <Setter Property="TextBlock.MaxLines" Value="0" />
    <Setter Property="TextBlock.TextTrimming" Value="None" />
    <Style Selector="^:disabled">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource colors.contentSecondary}" />
    </Style>
    <Style Selector="^:align-horizontal">
      <Setter Property="TextBlock.MaxLines" Value="3" />
      <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </ControlTheme>
  <!-- Description: the description under the label. -->
  <ControlTheme x:Key="Radio.StyledDescription" TargetType="TextBlock">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource colors.contentSecondary}" />
    <Setter Property="Cursor" Value="Ibeam" />
    <Setter Property="FontFamily" Value="{DynamicResource typography.ParagraphSmall.fontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource typography.ParagraphSmall.fontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource typography.ParagraphSmall.fontWeight}" />
    <Setter Property="LineHeight" Value="{DynamicResource typography.ParagraphSmall.lineHeight}" />
    <Setter Property="MaxLines" Value="0" />
    <Setter Property="TextTrimming" Value="None" />
    <Style Selector="^:align-horizontal">
      <Setter Property="MaxLines" Value="3" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </ControlTheme>
  <!-- RadioGroupRoot: the group's box. Its direction, wrap and gaps are the group's items panel (RadioGroup.axaml). -->
  <ControlTheme x:Key="RadioGroup.StyledRadioGroupRoot" TargetType="Border" />
</ResourceDictionary>
