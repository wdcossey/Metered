<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Libraries target net8.0 (Directory.Build.props). Tests run on the current runtime:
         xunit.v3 test projects are executables and need the SDK's own apphost pack. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Metered.Controls\Metered.Controls.csproj" />
    <ProjectReference Include="..\..\src\Metered.Themes\Metered.Themes.csproj" />
    <!-- The OFL substitutes for Uber Move (docs/decisions/0003-font.md), registered in Harness/TestApp.cs. -->
    <ProjectReference Include="..\..\src\Metered.Fonts\Metered.Fonts.csproj" />
    <!-- The sample, so Sample/ tests its shell and pages and PreviewGallery draws its own MainWindow. -->
    <ProjectReference Include="..\..\samples\Metered.Sample\Metered.Sample.csproj" />
  </ItemGroup>

  <!-- What Base Web's own style functions give, written by tools/reference/cases.js. -->
  <ItemGroup>
    <EmbeddedResource Include="Reference/*.oracle.json" LogicalName="Metered.Tests.Reference.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The manifest target (Directory.Build.targets), proved on fixtures of the tests' own:
       nested folders, forward slashes, and that each path loads. -->
  <PropertyGroup>
    <MeteredDiscoverXaml>true</MeteredDiscoverXaml>
  </PropertyGroup>
  <ItemGroup>
    <MeteredDiscoveredXaml Include="Discovery/Fixture/**/*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The census is the sample's, for its Debug line (Diagnostics/PerformanceMonitor); the budget counts with it. -->
    <Using Include="Metered.Sample.Diagnostics.StyleCensus" Alias="StyleCensus" />
  </ItemGroup>

</Project>
