<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="https://github.com/wdcossey/Metered"
             x:Class="Metered.Sample.Pages.ProgressBarPage">
  <!-- Base Web's progress bar, as its documentation's examples show it: basic, with a negative fill by override, the
       intents, with its label and a custom one, the sizes, the stepped bar with its buttons, and infinite. Headings are
       the shell's. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,0,16,32">
      <TextBlock Classes="heading" Text="Basic" />
      <b:ProgressBar x:Name="Basic" Value="40" />

      <TextBlock Classes="heading" Text="Negative colour" />
      <b:ProgressBar x:Name="Negative" Value="20">
        <b:ProgressBar.Overrides>
          <b:OverrideCollection>
            <b:Override Part="BarProgress">
              <b:Override.Style>
                <ControlTheme TargetType="b:ProgressBarFill">
                  <Setter Property="Background" Value="{DynamicResource colors.negative}" />
                </ControlTheme>
              </b:Override.Style>
            </b:Override>
          </b:OverrideCollection>
        </b:ProgressBar.Overrides>
      </b:ProgressBar>

      <TextBlock Classes="heading" Text="Intent" />
      <StackPanel Spacing="16">
        <b:ProgressBar Value="50" ShowLabel="True" Intent="Positive" />
        <b:ProgressBar Value="50" ShowLabel="True" Intent="Warning" />
        <b:ProgressBar x:Name="Intent" Value="50" ShowLabel="True" Intent="Negative" />
        <b:ProgressBar Value="50" ShowLabel="True" Intent="Brand" />
      </StackPanel>

      <TextBlock Classes="heading" Text="With a label" />
      <b:ProgressBar x:Name="Labelled" Value="70" ShowLabel="True" />

      <TextBlock Classes="heading" Text="Custom label" />
      <b:ProgressBar x:Name="Custom" Value="50" ShowLabel="True" />

      <TextBlock Classes="heading" Text="Sizes" />
      <StackPanel Spacing="16">
        <b:ProgressBar x:Name="Small" Value="60" ShowLabel="True" Size="Small" />
        <b:ProgressBar Value="60" ShowLabel="True" Size="Medium" />
        <b:ProgressBar Value="60" ShowLabel="True" Size="Large" />
      </StackPanel>

      <TextBlock Classes="heading" Text="Steps" />
      <b:ProgressBar x:Name="Steps" Value="40" Steps="5" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,10,0,0">
        <b:Button x:Name="Previous" Size="Small" Width="116" Content="Previous Step" />
        <b:Button x:Name="Next" Size="Small" Width="116" Content="Next Step" />
      </StackPanel>

      <TextBlock Classes="heading" Text="Infinite" />
      <b:ProgressBar x:Name="Infinite" Infinite="True" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
