<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="https://github.com/wdcossey/Metered"
             x:Class="Metered.Sample.Pages.CheckboxPage">
  <!-- Base Web's Checkbox (the v1 baseweb.design shows): its states, an indeterminate parent, the toggle and the label placements. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,0,16,32">
      <TextBlock Classes="heading" Text="States" />
      <b:Checkbox Content="Checkbox" />
      <b:Checkbox Content="Checked" IsChecked="True" />
      <b:Checkbox Content="Error" Error="True" />
      <b:Checkbox Content="Error, checked" Error="True" IsChecked="True" />
      <b:Checkbox Content="Disabled" IsEnabled="False" />
      <b:Checkbox Content="Disabled, checked" IsEnabled="False" IsChecked="True" />

      <TextBlock Classes="heading" Text="Indeterminate" />
      <b:Checkbox x:Name="AllToppings" Content="All toppings" />
      <StackPanel Margin="12">
        <b:Checkbox x:Name="Cheese" Content="Cheese" IsChecked="True" />
        <b:Checkbox x:Name="Olives" Content="Olives" />
      </StackPanel>

      <TextBlock Classes="heading" Text="Toggle" />
      <StackPanel Spacing="12">
        <b:Checkbox x:Name="Toggle" CheckmarkType="Toggle" Content="Notifications" />
        <b:Checkbox CheckmarkType="Toggle" Content="Location" IsChecked="True" />
        <b:Checkbox CheckmarkType="Toggle" Content="Error" Error="True" IsChecked="True" />
        <b:Checkbox CheckmarkType="Toggle" Content="Disabled" IsEnabled="False" IsChecked="True" />
      </StackPanel>

      <TextBlock Classes="heading" Text="Label placement" />
      <b:Checkbox Content="Label on the top" LabelPlacement="Top" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
        <b:Checkbox Content="Left" LabelPlacement="Left" />
        <b:Checkbox Content="Right" LabelPlacement="Right" />
      </StackPanel>
      <b:Checkbox Content="Label on the bottom" LabelPlacement="Bottom" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
