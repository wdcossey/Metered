<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="https://github.com/wdcossey/Metered"
             x:Class="Metered.Sample.Pages.CheckboxPage">
  <!-- Base Web's checkbox-v2, after its docs page's examples: its states, an indeterminate parent, the two label
       placements and a label of several lines. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,0,16,32">
      <TextBlock Classes="heading" Text="States" />
      <b:Checkbox Content="Checkbox" />
      <b:Checkbox Content="Checked" IsChecked="True" />
      <b:Checkbox Content="Error" Error="True" />
      <b:Checkbox Content="Error, checked" Error="True" IsChecked="True" />
      <b:Checkbox Content="Disabled" IsEnabled="False" />
      <b:Checkbox Content="Disabled, checked" IsEnabled="False" IsChecked="True" />

      <TextBlock Classes="heading" Text="Indeterminate" />
      <b:Checkbox x:Name="AllToppings" Content="All toppings" />
      <StackPanel Margin="10,0,0,0">
        <b:Checkbox x:Name="Cheese" Content="Cheese" IsChecked="True" />
        <b:Checkbox x:Name="Olives" Content="Olives" />
      </StackPanel>

      <TextBlock Classes="heading" Text="Label placement" />
      <StackPanel Orientation="Horizontal">
        <b:Checkbox Content="Label on the left" LabelPlacement="Left" />
        <b:Checkbox Content="Label on the right" LabelPlacement="Right" />
      </StackPanel>

      <TextBlock Classes="heading" Text="Multiple lines" />
      <b:Checkbox IsChecked="True"
                  Content="Sign up for the newsletter: the week's new features, the changes on their way and the stories from those who use them, in one email each Friday." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
