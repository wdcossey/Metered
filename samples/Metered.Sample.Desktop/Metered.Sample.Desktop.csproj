<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop head: the sample in a phone-sized window, to see the controls by hand. It holds only
       the entry point; the app, its window, its shell, its pages and its fonts are Metered.Sample's. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metered.Sample\Metered.Sample.csproj" />
  </ItemGroup>

</Project>
