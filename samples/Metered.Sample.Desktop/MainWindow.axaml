<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="https://github.com/wdcossey/Metered"
        x:Class="Metered.Sample.Desktop.MainWindow"
        Title="Metered"
        Width="390" Height="844" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource colors.backgroundPrimary}">
  <!-- 390 x 844: the tests' phone view. -->
  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="{DynamicResource typography.HeadingSmall.fontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource typography.HeadingSmall.fontWeight}" />
      <Setter Property="Foreground" Value="{DynamicResource colors.contentPrimary}" />
      <Setter Property="Margin" Value="0,24,0,8" />
    </Style>
    <Style Selector="TextBlock.l">
      <Setter Property="FontSize" Value="{DynamicResource typography.LabelMedium.fontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource typography.LabelMedium.fontWeight}" />
      <Setter Property="Foreground" Value="{DynamicResource colors.contentSecondary}" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style Selector="WrapPanel > b|Button">
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
  </Window.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,8,16,32">
      <DockPanel Margin="0,16,0,0">
        <b:Button x:Name="Variant" DockPanel.Dock="Right" Kind="Secondary" Size="Compact" Content="Dark" />
        <TextBlock Classes="h" Margin="0" VerticalAlignment="Center" Text="Metered pilot" />
      </DockPanel>

      <TextBlock Classes="h" Text="Kinds" />
      <WrapPanel>
        <b:Button Kind="Primary" Content="Primary" />
        <b:Button Kind="Secondary" Content="Secondary" />
        <b:Button Kind="Tertiary" Content="Tertiary" />
        <b:Button Kind="DangerPrimary" Content="Danger" />
        <b:Button Kind="DangerSecondary" Content="Danger 2" />
        <b:Button Kind="DangerTertiary" Content="Danger 3" />
        <b:Button Kind="Outline" Content="Outline" />
        <b:Button Kind="Primary" IsEnabled="False" Content="Disabled" />
      </WrapPanel>

      <TextBlock Classes="h" Text="Sizes" />
      <WrapPanel>
        <b:Button Size="XSmall" Content="XSmall" />
        <b:Button Size="Small" Content="Small" />
        <b:Button Size="Medium" Content="Medium" />
        <b:Button Size="Large" Content="Large" />
      </WrapPanel>

      <TextBlock Classes="h" Text="Shapes" />
      <WrapPanel>
        <b:Button Shape="Default" Content="Default" />
        <b:Button Shape="Pill" Content="Pill" />
        <b:Button Shape="Circle" Content="+" />
        <b:Button Shape="Square" Content="+" />
        <b:Button Shape="Round" Kind="Secondary" Content="+" />
      </WrapPanel>

      <TextBlock Classes="h" Text="States" />
      <WrapPanel>
        <b:Button x:Name="Loading" Content="Click to load" />
        <b:Button Kind="Secondary" IsSelected="True" Content="Selected" />
        <b:Button Kind="Tertiary" MinHitArea="Tap" Size="XSmall" Content="Tap area" />
      </WrapPanel>
      <b:Button WidthType="Fill" Content="Fill width" />

      <TextBlock Classes="h" Text="Enhancers" />
      <WrapPanel>
        <b:Button Content="Start" StartEnhancer="←" />
        <b:Button Kind="Secondary" Content="End" EndEnhancer="→" />
        <b:Button Kind="Tertiary" Content="Both" StartEnhancer="★" EndEnhancer="→" />
      </WrapPanel>

      <TextBlock Classes="h" Text="ButtonGroup" />
      <TextBlock Classes="l" Text="Radio (arrow keys move)" />
      <b:ButtonGroup x:Name="Radio" Mode="Radio" PaddingType="None">
        <b:Button Content="Day" />
        <b:Button Content="Week" />
        <b:Button Content="Month" />
      </b:ButtonGroup>
      <TextBlock Classes="l" Text="Checkbox" />
      <b:ButtonGroup x:Name="Checks" Mode="Checkbox" PaddingType="None" Size="Small" Shape="Pill">
        <b:Button Content="Wi-Fi" />
        <b:Button Content="Parking" />
        <b:Button Content="Pool" />
        <b:Button Content="Gym" />
      </b:ButtonGroup>
      <TextBlock Classes="l" x:Name="Clicked" Text="Clicked: none" />
      <TextBlock Classes="l" Text="Wrap" />
      <b:ButtonGroup Mode="Checkbox" PaddingType="None" Wrap="True" Size="XSmall" Kind="Tertiary">
        <b:Button Content="Breakfast" />
        <b:Button Content="Lunch" />
        <b:Button Content="Dinner" />
        <b:Button Content="Snacks" />
        <b:Button Content="Drinks" />
        <b:Button Content="Dessert" />
      </b:ButtonGroup>

      <TextBlock Classes="h" Text="Theme" />
      <TextBlock Classes="l" Text="A subtree's own createTheme, light and dark" />
      <!-- Given its themes in code: MainWindow.axaml.cs. -->
      <Border x:Name="Branded" Padding="12" Background="{DynamicResource colors.backgroundPrimary}">
        <WrapPanel>
          <b:Button Content="Primary" />
          <b:Button Kind="Secondary" Content="Secondary" />
          <b:Button Kind="Outline" Content="Outline" />
          <b:Button x:Name="BrandedLoading" Content="Click to load" />
        </WrapPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
